# deploy/postgres/pg-tuning.env — the SINGLE file to edit when the data VPS is
# resized. deploy/data-deploy.sh sources it (set -a) so docker compose's ${...}
# interpolation in docker-compose.data.yml picks these up.
#
# CURRENT PROFILE: 1 CPU / 256 MB / 10 GB disk.
#
# 256 MB is genuinely tight for PostgreSQL and the numbers below are the shape
# that fits, not a default anybody would pick with room to spare:
#
#   shared_buffers 64MB          ~25% of the limit, the usual starting ratio.
#   work_mem 2MB                 PER SORT/HASH NODE, not per connection. One
#                                query with four sort nodes across ten
#                                connections is 80MB. This is the number that
#                                OOM-kills a small Postgres, and raising it is
#                                the most common way to do that.
#   max_connections 40           The app caps itself well under this: two
#                                gunicorn workers x SQLAlchemy's pool. If you
#                                raise the pool, raise this, and vice versa —
#                                each backend costs a few MB of private memory
#                                inside the same 256MB cgroup.
#   parallel query OFF           A parallel worker is another backend AND uses
#                                /dev/shm, which is charged to the same limit.
#   max_wal_size 512MB           Checkpoints can leave ~2-3x this on disk, and
#                                the disk is 10 GB in total.
#
# On a resize, change PG_MEM_LIMIT and PG_CPUS here and re-run data-deploy.sh;
# scale shared_buffers to ~25% and effective_cache_size to ~75% of the new
# limit. Leave work_mem alone unless you have measured a specific query
# spilling to disk — read the note above first.

PG_CPUS=1.0
PG_MEM_LIMIT=256m

PG_MAX_CONNECTIONS=40
PG_SHARED_BUFFERS=64MB
PG_EFFECTIVE_CACHE_SIZE=192MB
PG_WORK_MEM=2MB
PG_MAINTENANCE_WORK_MEM=32MB
PG_MAX_WAL_SIZE=512MB
PG_MIN_WAL_SIZE=128MB

# Log anything slower than this (ms). Tighten once the app has soaked.
PG_LOG_MIN_DURATION=200

# ── Redis, same idea ────────────────────────────────────────────────────────
# REDIS_MEM_LIMIT is 1.25x REDIS_MAXMEMORY: the AOF-rewrite fork's
# copy-on-write pages need headroom, and sizing the container AT maxmemory
# means the OOM killer wins that race. Keep the ratio if you change either.
REDIS_MAXMEMORY=512mb
REDIS_MEM_LIMIT=640m
