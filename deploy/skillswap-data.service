# SkillSwap AI — data tier (Postgres + Redis) on the Redis VPS.
#
# Installed by deploy/setup-data-vps.sh, which substitutes @REPO_ROOT@.
#
# WHY THIS UNIT EXISTS AT ALL, given `restart: unless-stopped` on both
# containers: the containers PUBLISH on 10.77.0.1, the WireGuard address. That
# address does not exist until wg-quick@wg0 has brought the interface up. At
# boot, Docker starts on its own schedule, tries to bind an address that is not
# there yet, and fails with "cannot assign requested address" — and a container
# that cannot BIND does not enter a restart loop that later succeeds; it is
# simply down, hours after a change that worked when it was run by hand.
#
# The existing native Redis on this box already carries the same ordering as a
# drop-in (After=wg-quick@wg0.service). This is that, for the containers.
#
# Type=oneshot + RemainAfterExit=yes: `compose up -d` returns immediately and
# Docker supervises the containers from then on. systemd is doing ORDERING here,
# not process supervision — claiming otherwise (Type=simple) would have systemd
# consider the unit dead the moment compose exits.

[Unit]
Description=SkillSwap AI data tier (Postgres + Redis)
Documentation=file://@REPO_ROOT@/deploy/README.md
After=network-online.target wg-quick@wg0.service docker.service
Wants=network-online.target
Requires=wg-quick@wg0.service docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=-@REPO_ROOT@/deploy/postgres/pg-tuning.env
ExecStart=/usr/bin/docker compose -f @REPO_ROOT@/docker-compose.data.yml up -d
ExecStop=/usr/bin/docker compose -f @REPO_ROOT@/docker-compose.data.yml stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
