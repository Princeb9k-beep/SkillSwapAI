# SkillSwap AI — .env for the DOCKER deploy (this file lives at the repo ROOT).
#
# Copy to `.env` and fill it in. `.env` is git-ignored — and that is the entire
# reason secrets belong here rather than in a committed file: a live secret in a
# tracked file is a local modification, so the next `git pull` that touches it
# either refuses or gets "resolved" by discarding it. That is how a deployment
# loses a password nobody has written down anywhere else.
#
# THERE ARE TWO .env.example FILES AND THEY ARE FOR DIFFERENT THINGS:
#   * THIS one (repo root)  — the Docker deploy. docker compose reads it for
#     BOTH ${...} interpolation in the compose files AND env_file injection into
#     the container, so it has to be here and cannot live under backend/.
#   * backend/.env.example  — the bare-metal / Render path (uvicorn run by hand,
#     pydantic-settings reading ./.env from backend/). Still valid; unchanged.
# The application variables below are the same names in both.
#
# The SAME file is used on BOTH boxes, with different halves mattering:
#   app VPS   — DATABASE_URL / REDIS_URL point ACROSS the tunnel at the data VPS
#   data VPS  — POSTGRES_* / REDIS_PASSWORD / PGDATA_HOST_PATH configure the
#               containers being served
# Keeping one shape means the passwords are written once and cannot drift.

# ─────────────────────────────────────────────────────────────────────────────
# APP VPS — where the app finds its data tier
# ─────────────────────────────────────────────────────────────────────────────
# 10.77.0.1 is the data VPS INSIDE the WireGuard tunnel. Containers on the app
# box reach it with no compose changes: the host holds the wg0 route and
# Docker's MASQUERADE gives the traffic the 10.77.0.2 source the peer accepts.
# The URL is plain (not TLS) because WireGuard is the encryption.
DATABASE_URL=postgresql://skillswap:CHANGE_ME@10.77.0.1:5432/skillswapaidb
REDIS_URL=redis://default:CHANGE_ME@10.77.0.1:6380/0

# Two workers on the one allocated CPU (see the Dockerfile).
# ⚠ SET THIS TO 1 until app/realtime.py fans out over Redis pub/sub: the hub is
# a process-local dict, so with two workers a message written by one worker
# never reaches a WebSocket held by the other, and nothing errors.
GUNICORN_WORKERS=2

# ─────────────────────────────────────────────────────────────────────────────
# DATA VPS — the containers themselves
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=skillswap
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=skillswapaidb

# The redis service REFUSES TO START without this rather than running authless.
# Generate both of the above with:  openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME

# The 10 GB enforced ceiling created by deploy/setup-data-vps.sh. An ABSOLUTE
# path makes this a bind mount onto that filesystem; leave it UNSET and compose
# falls back to an uncapped named volume — correct for a laptop, wrong on the
# data VPS, where the ceiling is the whole point.
PGDATA_HOST_PATH=/srv/skillswap/pgdata

# The tunnel address the data containers publish on. NEVER 0.0.0.0: Docker DNATs
# a non-loopback publish in nat/PREROUTING, which is traversed before ufw's
# filter/INPUT, so a firewall "deny" does not stop it and `ufw status` reports
# the port closed while it is open to the internet.
WG_ADDR=10.77.0.1
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6380

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION — same names as backend/.env.example; see it for the full set
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=CHANGE_ME
APP_DEBUG=False
LOG_JSON=True

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# The public origin. Also what nginx's vhost is named for — set SKILLSWAP_DOMAIN
# to the bare hostname in the NOVA FLOW repo's .env (that stack owns 80/443).
FRONTEND_URL=https://skillswap.example.com
CORS_ORIGINS=*

ADMIN_EMAILS=
CRON_SECRET=

# Optional; each degrades cleanly when unset. See backend/.env.example.
RESEND_API_KEY=
SMTP_HOST=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
